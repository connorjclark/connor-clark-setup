#!/usr/bin/env bash

git log --all --format="%H | %s" | awk '
{
	# 1. Hexspeak words
	if ($1 ~ /^(c0ffee|dead|beef|badc0de|facade|deface|decaf|f00d)/) { 
		hex = hex $0 "\n" 
	}
	# 2. Repeating characters (8 in a row)
	else if ($1 ~ /(00000000|11111111|22222222|33333333|44444444|55555555|66666666|77777777|88888888|99999999|aaaaaaaa|bbbbbbbb|cccccccc|dddddddd|eeeeeeee|ffffffff)/) { 
		rep = rep $0 "\n" 
	}
	# 3. Sequential
	else if ($1 ~ /^123456/) { 
		seq = seq $0 "\n" 
	}
	# 4. Short hashes containing only numbers
	else if ($1 ~ /^[0-9]{7}/) { 
		num = num $0 "\n" 
	}
}
END {
	if (hex) print "=== HEXSPEAK ===\n" hex;
	if (rep) print "=== REPEATING CHARS ===\n" rep;
	if (seq) print "=== SEQUENTIAL ===\n" seq;
	if (num) print "=== NUMBERS ONLY (First 7) ===\n" num;
}'
