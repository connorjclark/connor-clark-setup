#!/usr/bin/env python3

import argparse
import subprocess
import sys
import os

def is_bisect_active():
    """Checks if a git bisect is currently in progress."""
    try:
        # Find the .git directory (works even if run from a subdirectory)
        git_dir = subprocess.check_output(
            ["git", "rev-parse", "--git-dir"], 
            stderr=subprocess.DEVNULL, 
            text=True
        ).strip()
        
        # Git creates the BISECT_START file when a bisect is active
        return os.path.isfile(os.path.join(git_dir, "BISECT_START"))
    except subprocess.CalledProcessError:
        # Fails if we aren't even inside a git repository
        return False

def run_and_capture(command):
    """Runs a command, streams its output to the terminal, and captures it as a string."""
    process = subprocess.Popen(
        command,
        shell=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )
    
    output_lines = []
    for line in process.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        output_lines.append(line)
        
    process.wait()
    return "".join(output_lines), process.returncode

def main():
    parser = argparse.ArgumentParser(description="Automates 'git bisect good/bad' in a loop.")
    parser.add_argument("--test", required=True, help="Command to run to test the commit.")
    parser.add_argument("--setup", help="Optional command to run before the test.")
    
    args = parser.parse_args()

    # --- NEW: Check if bisect is active before starting ---
    if not is_bisect_active():
        print("Error: No active git bisect found.")
        print("Please run 'git bisect start <bad> <good>' before running this script.")
        sys.exit(1)

    step = 1
    while True:
        print(f"\n{'='*10} Bisect Step {step} {'='*10}")
        
        # 1. Run the setup command if provided
        if args.setup:
            print(f"--- Running setup: {args.setup} ---")
            setup_result = subprocess.run(args.setup, shell=True)
            
            if setup_result.returncode != 0:
                print(f"\n=== Setup failed (exit code {setup_result.returncode}). Stopping loop. ===")
                sys.exit(1)

        # 2. Run the test command
        print(f"--- Running test: {args.test} ---")
        test_result = subprocess.run(args.test, shell=True)

        # 3. Mark good or bad based on the test's exit code
        bisect_cmd = "git bisect good" if test_result.returncode == 0 else "git bisect bad"
        print(f"--- Test returned {test_result.returncode}. Running '{bisect_cmd}' ---")
        
        bisect_output, bisect_code = run_and_capture(bisect_cmd)

        # 4. Check if bisect is finished or failed
        if bisect_code != 0:
            print(f"\n=== '{bisect_cmd}' failed. ===")
            sys.exit(1)

        # Git natively outputs "is the first bad commit" when it narrows down the culprit
        if "is the first bad commit" in bisect_output:
            print("\n=== Bisect complete! ===")
            break
            
        step += 1

if __name__ == "__main__":
    main()
